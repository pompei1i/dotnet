{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?maxPoolSize=20&serverSelectionTimeoutMS=3000&connectTimeoutMS=3000",
    "DatabaseName": "feedback_db",
    "SeedOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "MongoDB": "Warning",
        "MongoDB.Command": "Debug"
      }
    }
  }
}
