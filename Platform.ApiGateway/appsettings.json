{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "course-rating": {
        "ClusterId": "reviews",
        "Order": 1,
        "Match": { "Path": "/api/courses/{courseId:long}/rating" },
        "Metadata": { "Team": "feedback", "Version": "v1" }
      },
      "enrollments-catalog": {
        "ClusterId": "enrollments",
        "Order": 1,
        "Match": { "Path": "/api/enrollments/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ],
        "Metadata": { "Team": "enrollments", "Version": "v1" }
      },
      "orders": {
        "ClusterId": "enrollments",
        "Order": 100,
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "enrollments", "Version": "v1" }
      },
      "students": {
        "ClusterId": "enrollments",
        "Order": 100,
        "Match": { "Path": "/api/students/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "enrollments", "Version": "v1" }
      },
      "courses": {
        "ClusterId": "catalog",
        "Order": 100,
        "Match": { "Path": "/api/courses/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "categories": {
        "ClusterId": "catalog",
        "Order": 100,
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "instructors": {
        "ClusterId": "catalog",
        "Order": 100,
        "Match": { "Path": "/api/instructors/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 100,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "feedback", "Version": "v1" }
      },
      "discussions": {
        "ClusterId": "reviews",
        "Order": 100,
        "Match": { "Path": "/api/discussions/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ],
        "Metadata": { "Team": "feedback", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "enrollments": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://enrollments-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://courses-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  },
  "AllowedHosts": "*"
}
