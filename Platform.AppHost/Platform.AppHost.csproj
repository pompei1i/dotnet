<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3039e6c0-b4fb-4c9c-8c1b-1665798c18ee</UserSecretsId>
    <!-- Dashboard і оркестратор беруться з NuGet, тому AppHost запускається звичайним
         "dotnet run" без встановленого Aspire CLI. ASPIRE010 лише нагадує про цей вибір. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Services\Enrollments\Enrollments.Api\Enrollments.Api.csproj" />
    <ProjectReference Include="..\Services\Courses\Courses.Api\Courses.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
  </ItemGroup>

</Project>
