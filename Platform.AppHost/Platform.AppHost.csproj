<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3039e6c0-b4fb-4c9c-8c1b-1665798c18ee</UserSecretsId>
    <!-- Dashboard і оркестратор беруться з NuGet, тому AppHost запускається звичайним
         "dotnet run" без встановленого Aspire CLI. ASPIRE010 лише нагадує про цей вибір. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Services\Enrollments\Enrollments.Api\Enrollments.Api.csproj" />
    <ProjectReference Include="..\Services\Courses\Courses.Api\Courses.Api.csproj" />
    <ProjectReference Include="..\Services\Reviews\Reviews.WebApi\Reviews.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.6.1" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
  </ItemGroup>

  <!-- Aspire 13.6.1 тягне транзитивно версії з відомими вразливостями (GHSA-qhrr-8q5h-9q3h,
       GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) — закріплюємо виправлені -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
